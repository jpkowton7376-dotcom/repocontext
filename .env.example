# ─── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub OAuth (required for private-repo analysis) ────────────────
# RepoContext uses Supabase's built-in GitHub auth provider — no custom
# OAuth server needed. To enable private-repo analysis:
#   1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#      Homepage: https://www.repocontext.dev
#      Callback URL: https://www.repocontext.dev/auth/callback
#   2. Supabase → Authentication → Providers → GitHub
#      paste Client ID + Client Secret, set Scopes: repo read:org user:email
#   3. (optional) GITHUB_TOKEN below raises the ANONYMOUS rate limit only;
#      it does NOT grant private-repo access to signed-in users.
GITHUB_TOKEN=

# ─── LLM (optional — falls back to a deterministic template without it)
# Defaults work with OpenAI's API. For other OpenAI-compatible providers
# (DeepSeek, DashScope/Qwen, …), set OPENAI_BASE_URL and the model names.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FREE=gpt-4o-mini
OPENAI_MODEL_PAID=gpt-4o

# ─── Creem (payments) ──────────────────────────────────────────────────
# Both keys come from the SAME Creem environment (test or live).
# Set CREEM_TEST_MODE=false for the live environment.
CREEM_TEST_MODE=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_TEAM=
CREEM_PRODUCT_LIFETIME=

# ─── Public site URL (used in OG tags, share links, sitemap) ──────────
NEXT_PUBLIC_SITE_URL=https://www.repocontext.dev

# ─── Sentry (error monitoring) — leave empty to disable ──────────────
# Sign up at https://sentry.io, create a Next.js project, copy the DSN.
# The Sentry SDK is installed and the Next config is wrapped, but it
# stays a no-op when these are empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─── Resend (transactional email) — leave empty to disable ─────────
# Sign up at https://resend.com (free tier = 3 000 emails/month).
# Verify your sending domain (e.g. repocontext.dev) in the Resend
# dashboard, then set the from address below to a mailbox on that
# domain. While RESEND_API_KEY is empty, all email sends are no-ops.
RESEND_API_KEY=
RESEND_FROM=

# ─── Rate limiting ───────────────────────────────────────────────────────
# The public API (/api/v1/analyze) enforces a per-key limit using a Postgres
# table. Run supabase/api_key_rate_buckets.sql in your Supabase SQL editor
# once; until that table exists the limiter fails open (no limit).
