# ───────────────────────────────────────────────────────────────
# RepoContext — environment variables
# Copy this file to `.env.local` and fill in the values.
# In Vercel: Project Settings → Environment Variables.
# ───────────────────────────────────────────────────────────────

# ── AI (optional but recommended — improves AGENTS.md quality)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# ── GitHub (recommended — avoids unauthenticated API rate limits)
GITHUB_TOKEN=ghp_xxx

# ── Supabase (REQUIRED for login / dashboard / payments)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# ── Creem payments (REQUIRED for real checkout; skip for free-only launch)
CREEM_API_KEY=creem_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx
CREEM_TEST_MODE=true
CREEM_PRODUCT_PRO=prod_xxx
CREEM_PRODUCT_TEAM=prod_xxx
CREEM_PRODUCT_LIFETIME=prod_xxx

# ── App
NEXT_PUBLIC_SITE_URL=https://your-domain.com
