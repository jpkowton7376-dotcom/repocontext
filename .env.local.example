# ==========================================
# 基础配置
# ==========================================

# OpenAI API Key（可选，没有也能跑，只是模板版）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# GitHub Token（建议配置，避免频率限制）
# 申请地址: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# Supabase（用户系统 & 数据库）
# ==========================================
# 注册: https://supabase.com/ （免费层 500MB / 5万 MAU）
# 在 Settings → API 里找到

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key（服务端用，不要暴露到前端）
# 在 Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# Creem（支付 & 订阅，无需公司主体）
# ==========================================
# 注册: https://www.creem.io/ (个人即可，Merchant of Record 自动代缴 VAT)
# 在 Developers → API keys 里找到密钥

CREEM_API_KEY=creem_xxxxxxxxxxxxxxxxxxxx
CREEM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# 测试模式：true 用 test-api.creem.io，false 用 api.creem.io
CREEM_TEST_MODE=true

# 订阅产品 ID（在 Creem Dashboard → Products → Add product 后填进来）
CREEM_PRODUCT_PRO=prod_xxxxxxxxxxxxxxxx
CREEM_PRODUCT_TEAM=prod_xxxxxxxxxxxxxxxx

# ==========================================
# 应用配置
# ==========================================

# 网站域名（上线后改成你的域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 免费用户每日分析次数限制
FREE_DAILY_LIMIT=3
